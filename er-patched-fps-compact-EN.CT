    local _gt = createTimer(nil)
    _gt.Interval = 100
    _gt.OnTimer = function() pcall(function() _self.Active = false end) _gt.destroy() end
    return
  end
end
_G.__ER_FPS_WANTED = true
pcall(writeBytes, "ER_FPS_PATCH_ENABLED", 1)
