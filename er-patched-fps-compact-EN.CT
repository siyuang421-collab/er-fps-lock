    <CheatEntry>
      <ID>100</ID>
      <Description>"Position-Trigger Auto FPS Lock"</Description>
      <Color>00FFCC</Color>
      <GroupHeader>1</GroupHeader>
      <CheatEntries>
        <CheatEntry>
          <ID>101</ID>
          <Description>"Enable Position Trigger [OFF]"</Description>
          <Color>FFFFFF</Color>
          <VariableType>Auto Assembler Script</VariableType>
          <AssemblerScript>[ENABLE]
{$lua}
if syntaxcheck then return end
-- ============================================================
-- ID 101 位置触发主开关 ENABLE 脚本（纯 Lua 版，用于语法验证）
-- ============================================================
local MAXSLOT    = 80
local SLOTSIZE   = 24
local RADIUS_OFF = 0x800

-- 互斥：FPS Patch(ID1) 已激活时，阻止启用位置触发（GUI 点击必然执行此段）
do
  local _r1 = getAddressList().getMemoryRecordByID(1)
  if _r1 and _r1.Active then
    pcall(getMainForm().bringToFront)
    pcall(showMessage, "Disable FPS Patch first, then enable Position Trigger")
    local _self = getAddressList().getMemoryRecordByID(101)
    local _gt = createTimer(nil)
    _gt.Interval = 100
    _gt.OnTimer = function()
      pcall(function() _self.Active = false end)
      _gt.destroy()
    end
    return
  end
end

_G.AutoFps_Active = true

if _G.AutoFps_Timer then
  pcall(function() _G.AutoFps_Timer.destroy() end)
  _G.AutoFps_Timer = nil
end

-- 分配内存
if not _G.AutoFps_Config then
  _G.AutoFps_Config = allocateMemory(2304)
  registerSymbol("AutoFps_Config", _G.AutoFps_Config)
end
local cfg = _G.AutoFps_Config

-- 记录启用位置触发前的手动帧率（关闭时若需恢复手动帧用）
pcall(function() _G.AutoFps_ManualLimit = readFloat("ER_FPS_CUSTOM_LIMIT") end)

-- 默认半径
if readFloat(cfg + RADIUS_OFF) == 0 then
  writeFloat(cfg + RADIUS_OFF, 5.0)
end

-- 从保存文件恢复上次的点位（文件不存在则跳过）
if _G.AutoFps_Load then pcall(_G.AutoFps_Load, cfg) end

_G.AutoFps_EntrySlot = {}
local descCache = {}

-- AOB 扫描：得到固定的全局指针变量地址（实例会随坐赐福/传送变化，不能缓存实例）
local function scanWcm()
  pcall(unregisterSymbol, "WorldChrMan_AOB")
  local ok = autoAssemble([[
aobscanmodule(WorldChrMan_AOB, eldenring.exe, 48 8B 05 ?? ?? ?? ?? 48 85 C0 74 0F 48 39 88)
registersymbol(WorldChrMan_AOB)
]])
  if not ok then return false end
  local scanAddr = getAddressSafe("WorldChrMan_AOB")
  if not scanAddr or scanAddr == 0 then return false end
  local disp = readInteger(scanAddr + 3)
  _G.AutoFps_PtrVarAddr = scanAddr + 7 + disp
  return _G.AutoFps_PtrVarAddr ~= 0
end

-- 每次从固定指针变量读取当前 WorldChrMan 实例（坐赐福/传送后自动拿到新实例）
local function getWcm()
  if not _G.AutoFps_PtrVarAddr or _G.AutoFps_PtrVarAddr == 0 then return 0 end
  local inst = readQword(_G.AutoFps_PtrVarAddr)
  if inst and inst ~= 0 then
    _G.AutoFps_WorldChrAddr = inst
    return inst
  end
  return 0
end

local function readPos()
  local wcm = getWcm()
  if not wcm or wcm == 0 then return nil end
  local p1 = readQword(wcm + 0x10EF8)
  if p1 == 0 then return nil end
  local co = readQword(p1 + 0)
  if co == 0 then return nil end
  return {
    mapID = readInteger(co + 0x6D0),
    x = readFloat(co + 0x6C0),
    y = readFloat(co + 0x6C4),
    z = readFloat(co + 0x6C8)
  }
end

local function mapIdToStr(id)
  if not id or id == 0 then return "not set" end
  local b3 = math.floor(id / 0x1000000) % 256
  local b2 = math.floor(id / 0x10000) % 256
  local b1 = math.floor(id / 0x100) % 256
  local b0 = id % 256
  return string.format("m%d_%02d_%02d_%02d", b3, b2, b1, b0)
end

local function setDesc(eid, text)
  if descCache[eid] ~= text then
    descCache[eid] = text
    local rec = getAddressList().getMemoryRecordByID(eid)
    if rec then rec.Description = text end
  end
end

-- 列表刷新
local function refreshList()
  _G.AutoFps_EntrySlot = {}
  local openLine = 0
  local closeLine = 0
  for i = 0, MAXSLOT - 1 do
    local off = i * SLOTSIZE
    local mID = readInteger(cfg + off)
    if mID ~= 0 then
      local st = readInteger(cfg + off + 16)
      local sx = readFloat(cfg + off + 4)
      local sy = readFloat(cfg + off + 8)
      local sz = readFloat(cfg + off + 12)
      local fps = readFloat(cfg + off + 20)
      if st == 1 and openLine &lt; 40 then
        openLine = openLine + 1
        local eid = 200 + openLine - 1
        _G.AutoFps_EntrySlot[eid] = i
        setDesc(eid, string.format("%d. %s [%.0f fps] (%.1f,%.1f,%.1f)",
          openLine, mapIdToStr(mID), fps, sx, sy, sz))
      elseif st == 2 and closeLine &lt; 40 then
        closeLine = closeLine + 1
        local eid = 300 + closeLine - 1
        _G.AutoFps_EntrySlot[eid] = i
        setDesc(eid, string.format("%d. %s (%.1f,%.1f,%.1f)",
          closeLine, mapIdToStr(mID), sx, sy, sz))
      end
    end
  end
  for k = openLine, 39 do setDesc(200 + k, " ") end
  for k = closeLine, 39 do setDesc(300 + k, " ") end
end

-- 触发检测
local function checkTrigger(p)
  local radius = readFloat(cfg + RADIUS_OFF)
  for i = 0, MAXSLOT - 1 do
    local off = i * SLOTSIZE
    local mID = readInteger(cfg + off)
    if mID ~= 0 and p.mapID == mID then
      local sx = readFloat(cfg + off + 4)
      local sy = readFloat(cfg + off + 8)
      local sz = readFloat(cfg + off + 12)
      local st = readInteger(cfg + off + 16)
      local fps = readFloat(cfg + off + 20)
      local d = math.sqrt((p.x - sx)^2 + (p.y - sy)^2 + (p.z - sz)^2)
      if d &lt; radius then
        if st == 1 then
          pcall(writeBytes, "ER_FPS_PATCH_ENABLED", 1)
          if fps &gt;= 20 and fps &lt;= 60 then
            pcall(writeFloat, "ER_FPS_CUSTOM_LIMIT", fps)
          end
          _G.__ER_FPS_WANTED = true
          setDesc(1, string.format("FPS Patch [%.0f auto]", fps))
        elseif st == 2 then
          pcall(writeBytes, "ER_FPS_PATCH_ENABLED", 0)
          _G.__ER_FPS_WANTED = false
          setDesc(1, "FPS Patch [OFF auto]")
        end
      end
    end
  end
end

local saveCounter = 0
_G.AutoFps_Timer = createTimer(getMainForm())
_G.AutoFps_Timer.Interval = 500
_G.AutoFps_Timer.OnTimer = function()
  pcall(function()
    setDesc(102, string.format("Trigger radius (m): %.1f  [click to edit]", readFloat(cfg + RADIUS_OFF)))
    -- 指针变量地址固定，仅在尚未扫描到（或游戏重启后失效）时重新扫描；
    -- 实例地址每次由 getWcm() 重新读取，坐赐福/传送后自动更新
    if not _G.AutoFps_PtrVarAddr or _G.AutoFps_PtrVarAddr == 0 then
      scanWcm()
    end
    -- 列表刷新独立于角色读取：即使读不到角色位置，点位列表也要显示
    refreshList()
    local p = readPos()
    if not p then
      setDesc(150, "Current pos: not readable")
    else
      setDesc(150, "Current pos: " .. mapIdToStr(p.mapID) ..
        string.format(" (%.1f,%.1f,%.1f)", p.x, p.y, p.z))
      checkTrigger(p)
    end
    -- 每 10 次 tick（约 5 秒）自动保存一次，防止 CE 崩溃/强杀丢失点位
    saveCounter = saveCounter + 1
    if saveCounter &gt;= 10 then
      saveCounter = 0
      if _G.AutoFps_Save then _G.AutoFps_Save(cfg) end
    end
  end)
end

getAddressList().getMemoryRecordByID(101).Description = "Enable Position Trigger [ON]"
[DISABLE]
{$lua}
if syntaxcheck then return end
-- ID 101 DISABLE 清理脚本
if syntaxcheck then return end
_G.AutoFps_Active = false
_G.__ER_FPS_RESYNC = true

-- 关闭位置触发时恢复帧率：判断用户是否手动开着 FPS Patch(ID1)
local id1 = getAddressList().getMemoryRecordByID(1)
local manualPatch = (id1 ~= nil) and id1.Active
if manualPatch then
  -- 手动锁帧：保持 patch，恢复到启用位置触发前的手动帧率
  _G.__ER_FPS_WANTED = true
  pcall(writeBytes, "ER_FPS_PATCH_ENABLED", 1)
  local ml = _G.AutoFps_ManualLimit
  if ml and ml &gt;= 20 and ml &lt;= 60 then
    pcall(writeFloat, "ER_FPS_CUSTOM_LIMIT", ml)
  end
else
  -- 纯位置触发：关闭 patch，解除锁帧让游戏恢复原生帧率
  _G.__ER_FPS_WANTED = false
  pcall(writeBytes, "ER_FPS_PATCH_ENABLED", 0)
end

if _G.AutoFps_Timer then
  pcall(function() _G.AutoFps_Timer.destroy() end)
  _G.AutoFps_Timer = nil
end

if _G.AutoFps_Config then
  -- 释放内存前先保存到文件
  if _G.AutoFps_Save then pcall(_G.AutoFps_Save, _G.AutoFps_Config) end
  pcall(unregisterSymbol, "AutoFps_Config")
  pcall(deAlloc, _G.AutoFps_Config, 2304)
  _G.AutoFps_Config = nil
end

pcall(unregisterSymbol, "WorldChrMan_AOB")
_G.AutoFps_WorldChrAddr = 0
_G.AutoFps_PtrVarAddr = 0

for eid = 200, 239 do
  local rec = getAddressList().getMemoryRecordByID(eid)
  if rec then rec.Description = " " end
end
for eid = 300, 339 do
  local rec = getAddressList().getMemoryRecordByID(eid)
  if rec then rec.Description = " " end
end

local r101 = getAddressList().getMemoryRecordByID(101)
if r101 then r101.Description = "Enable Position Trigger [OFF]" end</AssemblerScript>
