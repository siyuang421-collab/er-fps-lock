  <UserdefinedSymbols/>
  <LuaScript>-- ============================================================
-- 顶层脚本：UI 美化 + 自动附加 + DLL 符号等待 + FPS 持久化
-- ============================================================

-- ---------- UI 美化 ----------
getMainForm().Splitter1.Visible = false
getMainForm().Panel4.Visible = false
getMainForm().Panel5.Visible = false

local al = GetAddressList()
al.Control[0].BackgroundColor = 0x000000
al.Header.Visible = false
for _, i in ipairs({2, 3, 4}) do
  al.Header.Sections[i].MinWidth = 0
  al.Header.Sections[i].MaxWidth = 0
  al.Header.Sections[i].Width = 0
end
al.Header.Sections[1].MinWidth = 200
al.Header.Sections[1].Width = 400

-- 缩小激活(勾选框)列，让描述文字整体向左靠
pcall(function()
  al.Header.Sections[0].MinWidth = 0
  al.Header.Sections[0].Width = 42
end)

-- ---------- 持久化全局函数（点位/半径/FPS限制） ----------
-- 保存到 用户主目录\EldenRingFps：路径固定可预测，不受"文档"被重定向到
-- D盘/OneDrive影响；os.getenv("USERPROFILE") 每台机器自动适配用户名
function _G.AutoFps_GetSaveDir()
  local up = os.getenv("USERPROFILE") or getCheatEngineDir()
  local dir = up .. [[\EldenRingFps]]
  pcall(createDir, dir)
  return dir
end

function _G.AutoFps_GetSavePath()
  return _G.AutoFps_GetSaveDir() .. [[\er_fps_save.txt]]
end

function _G.AutoFps_Save(cfg)
  if not cfg or cfg == 0 then return false end
  local f = io.open(_G.AutoFps_GetSavePath(), "w")
  if not f then return false end
  local radius = readFloat(cfg + 0x800)
  local limit
  pcall(function() limit = readFloat("ER_FPS_CUSTOM_LIMIT") end)
  f:write("ERFPS1\n")
  f:write("radius=" .. tostring(radius) .. "\n")
  f:write("limit=" .. tostring(limit) .. "\n")
  for i = 0, 79 do
    local off = i * 24
    local mID = readInteger(cfg + off)
    if mID and mID ~= 0 then
      local x = readFloat(cfg + off + 4)
      local y = readFloat(cfg + off + 8)
      local z = readFloat(cfg + off + 12)
      local typ = readInteger(cfg + off + 16)
      local fps = readFloat(cfg + off + 20)
      f:write(string.format("%d,%d,%.6f,%.6f,%.6f,%d,%.6f\n",
        i, mID, x, y, z, typ, fps))
    end
  end
  f:close()
  return true
end

function _G.AutoFps_Load(cfg)
  if not cfg or cfg == 0 then return nil end
  local f = io.open(_G.AutoFps_GetSavePath(), "r")
  if not f then return nil end
  local savedRadius, savedLimit
  local header = f:read("*l")
  if header ~= "ERFPS1" then f:close() return nil end
  while true do
    local line = f:read("*l")
    if not line then break end
    if line:sub(1, 7) == "radius=" then
      savedRadius = tonumber(line:sub(8))
    elseif line:sub(1, 6) == "limit=" then
      savedLimit = tonumber(line:sub(7))
    else
      local parts = {}
      for tok in line:gmatch("[^,]+") do parts[#parts + 1] = tok end
      if #parts == 7 then
        local slot = tonumber(parts[1])
        local mID = tonumber(parts[2])
        local x = tonumber(parts[3])
        local y = tonumber(parts[4])
        local z = tonumber(parts[5])
        local typ = tonumber(parts[6])
        local fps = tonumber(parts[7])
        if slot and mID and x and y and z and typ and fps then
          local off = slot * 24
          writeInteger(cfg + off, mID)
          writeFloat(cfg + off + 4, x)
          writeFloat(cfg + off + 8, y)
          writeFloat(cfg + off + 12, z)
          writeInteger(cfg + off + 16, typ)
          writeFloat(cfg + off + 20, fps)
        end
      end
    end
  end
  f:close()
  if savedRadius and savedRadius &gt; 0 then
    writeFloat(cfg + 0x800, savedRadius)
  end
  return savedLimit
end

-- 只读取保存文件里的 limit（CE 重启、config 尚未分配时用）
function _G.AutoFps_ReadSavedLimit()
  local f = io.open(_G.AutoFps_GetSavePath(), "r")
  if not f then return nil end
  local result
  if f:read("*l") == "ERFPS1" then
    while true do
      local line = f:read("*l")
      if not line then break end
      if line:sub(1, 6) == "limit=" then
        result = tonumber(line:sub(7))
        break
      end
    end
  end
  f:close()
  return result
end

-- ---------- 配置 ----------
local PROCESS_NAME = "eldenring.exe"
local SYM_PATCH    = "ER_FPS_PATCH_ENABLED"
local SYM_LIMIT    = "ER_FPS_CUSTOM_LIMIT"
local REC_PATCH    = 1
local INTERVAL_MS  = 1000
local SETTLE_TICKS = 2
local REINIT_COOLDOWN = 3
local REINIT_BUDGET = 20
local GRACE_TICKS  = 5

local settle = 0
local symbolsLoaded = false
local initialized = false
local checkboxSynced = false
local reinitCooldown = 0
local reinitBudget = 0
local graceTicks = 0
local lastLabel = nil
local lastModules = nil

if _G.__ER_FPS_PERSIST_TIMER then
  pcall(function() _G.__ER_FPS_PERSIST_TIMER.destroy() end)
  _G.__ER_FPS_PERSIST_TIMER = nil
end

local function patchRecord()
  local ok, rec = pcall(function()
    return getAddressList().getMemoryRecordByID(REC_PATCH)
  end)
  if ok then return rec end
  return nil
end

local function setLabel(state)
  -- 位置触发激活期间，ID1 描述完全交给位置 timer（[45 自动]/[OFF 自动]）
  if _G.AutoFps_Active then return end
  if state == lastLabel then return end
  lastLabel = state
  local rec = patchRecord()
  if rec == nil then return end
  pcall(function() rec.Description = "FPS Patch [" .. state .. "]" end)
end

local function moduleCount()
  local ok, mods = pcall(enumModules)
  if ok and mods ~= nil then return #mods end
  return nil
end

local function symbolOk(sym)
  local ok, a = pcall(getAddressSafe, sym)
  if not ok then return false end
  return a ~= nil and a ~= 0
end

local function readFlag()
  local ok, b = pcall(readBytes, SYM_PATCH, 1, false)
  if ok and type(b) == "number" then return b end
  return nil
end

local function resetAttachState()
  settle = SETTLE_TICKS
  symbolsLoaded = false
  initialized = false
  checkboxSynced = false
  reinitCooldown = 0
  reinitBudget = REINIT_BUDGET
  graceTicks = 0
  lastModules = nil
end

if _G.__ER_FPS_WANTED == nil then
  local rec = patchRecord()
  _G.__ER_FPS_WANTED = (rec ~= nil) and rec.Active or false
end

local function tick()
  -- 位置触发刚关闭时，强制重新同步一次 label
  if _G.__ER_FPS_RESYNC then
    lastLabel = nil
    _G.__ER_FPS_RESYNC = nil
  end
  local pid = getProcessIDFromProcessName(PROCESS_NAME)
  if pid == nil then
    if symbolsLoaded or initialized then resetAttachState() end
    symbolsLoaded = false
    if _G.__ER_FPS_WANTED then setLabel("WAIT") else setLabel("OFF") end
    return
  end

  if getOpenedProcessID() ~= pid then
    pcall(openProcess, pid)
    if getOpenedProcessID() == pid then resetAttachState() end
    if _G.__ER_FPS_WANTED then setLabel("WAIT") else setLabel("OFF") end
    return
  end

  if settle ~= 0 then
    settle = settle - 1
    if _G.__ER_FPS_WANTED then setLabel("WAIT") else setLabel("OFF") end
    return
  end

  if reinitCooldown ~= 0 then reinitCooldown = reinitCooldown - 1 end

  if not symbolsLoaded then
    if symbolOk(SYM_PATCH) and symbolOk(SYM_LIMIT) then
      symbolsLoaded = true
    else
      local mods = moduleCount()
      local changed = (mods ~= nil) and (mods ~= lastModules)
      if changed then lastModules = mods end
      if changed and reinitCooldown == 0 and reinitBudget ~= 0 then
        reinitBudget = reinitBudget - 1
        reinitCooldown = REINIT_COOLDOWN
        pcall(reinitializeSymbolhandler, false)
      end
      if _G.__ER_FPS_WANTED then setLabel("WAIT") else setLabel("OFF") end
      return
    end
  end

  if not initialized then
    if _G.__ER_FPS_LAST_LIMIT == nil then
      -- CE 重启后全局丢失，尝试从保存文件恢复上次帧率
      local fl = _G.AutoFps_ReadSavedLimit()
      if fl and fl &gt;= 20 and fl &lt;= 60 then
        _G.__ER_FPS_LAST_LIMIT = fl
      end
    end
    if _G.__ER_FPS_LAST_LIMIT ~= nil then
      pcall(writeFloat, SYM_LIMIT, _G.__ER_FPS_LAST_LIMIT)
      graceTicks = GRACE_TICKS
    end
    initialized = true
  end

  -- FPS限制行显示当前数值（值列已隐藏，用描述展示）
  pcall(function()
    local rec2 = getAddressList().getMemoryRecordByID(2)
    if rec2 then
      rec2.Description = string.format("FPS Limit: %.1f", readFloat(SYM_LIMIT))
    end
  end)

  -- 位置触发激活时，patch 字节控制权交给位置 timer，这里只做 FPS 持久化
  local cur = readFlag()
  if cur == nil then
    symbolsLoaded = false
    if _G.__ER_FPS_WANTED then setLabel("WAIT") else setLabel("OFF") end
    return
  end

  if not _G.AutoFps_Active then
    local target = 0
    if _G.__ER_FPS_WANTED then target = 1 end
    if cur ~= target then
      pcall(writeBytes, SYM_PATCH, target)
      local check = readFlag()
      if check ~= nil then cur = check end
    end
  end

  if _G.__ER_FPS_WANTED then
    if cur == 1 then setLabel("ON") else setLabel("WAIT") end
  else
    setLabel("OFF")
  end

  if not _G.AutoFps_Active and _G.__ER_FPS_WANTED and cur == 1 and not checkboxSynced then
    checkboxSynced = true
    local rec = patchRecord()
    if rec ~= nil and not rec.Active then
      pcall(function() rec.Active = true end)
    end
  end

  local okF, curLimit = pcall(readFloat, SYM_LIMIT)
  if okF and type(curLimit) == "number" then
    if graceTicks ~= 0 then
      graceTicks = graceTicks - 1
      if _G.__ER_FPS_LAST_LIMIT ~= nil and curLimit ~= _G.__ER_FPS_LAST_LIMIT then
        pcall(writeFloat, SYM_LIMIT, _G.__ER_FPS_LAST_LIMIT)
      end
    else
      _G.__ER_FPS_LAST_LIMIT = curLimit
    end
  end
end

local timer = createTimer(getMainForm())
timer.Interval = INTERVAL_MS
timer.OnTimer = function() pcall(tick) end
_G.__ER_FPS_PERSIST_TIMER = timer

-- 在界面上显示点位保存文件的实际路径，方便分发时知道 txt 放哪
pcall(function()
  if _G.AutoFps_GetSavePath then
    local r151 = getAddressList().getMemoryRecordByID(151)
    if r151 then r151.Description = "Points saved to: " .. _G.AutoFps_GetSavePath() end
  end
end)

-- ---------- 双击开锁点行直接改帧数 ----------
pcall(function()
  local tree = getAddressList().List
  tree.OnDblClick = function(sender)
    pcall(function()
      local al = getAddressList()
      local rec = al.SelectedRecord or al.MouseHighlightedRecord()
      if not rec then return end
      local id = rec.ID
      if id == 2 then
        -- FPS 限制行：双击直接改 ER_FPS_CUSTOM_LIMIT
        pcall(getMainForm().bringToFront)
        local okL, curL = pcall(readFloat, "ER_FPS_CUSTOM_LIMIT")
        local init = okL and string.format("%.0f", curL) or "60"
        local newL = inputQuery("Change FPS", "Enter FPS limit (20-60):", init)
        if newL == nil then return end
        local v = tonumber(newL)
        if not v or v &lt; 20 or v &gt; 60 then
          showMessage("FPS must be between 20 and 60") return
        end
        pcall(writeFloat, "ER_FPS_CUSTOM_LIMIT", v)
      elseif id &gt;= 200 and id &lt;= 239 then
        if not _G.AutoFps_Config then return end
        local slot = _G.AutoFps_EntrySlot and _G.AutoFps_EntrySlot[id]
        if slot == nil then return end
        pcall(getMainForm().bringToFront)
        local curFps = readFloat(_G.AutoFps_Config + slot*24 + 20)
        local newFps = inputQuery("Change FPS", "Enter new FPS for this open point (20-60):",
          string.format("%.0f", curFps))
        if newFps == nil then return end
        local fps = tonumber(newFps)
        if not fps or fps &lt; 20 or fps &gt; 60 then
          showMessage("FPS must be between 20 and 60") return
        end
        writeFloat(_G.AutoFps_Config + slot*24 + 20, fps)
        local okb, b = pcall(readBytes, "ER_FPS_PATCH_ENABLED", 1, false)
        if okb and b == 1 then
          pcall(writeFloat, "ER_FPS_CUSTOM_LIMIT", fps)
        end
        if _G.AutoFps_Save then _G.AutoFps_Save(_G.AutoFps_Config) end
      end
    end)
  end
end)

-- ---------- 统一恢复：非手动锁帧时写 patch=0 解除，并保存点位 ----------
function _G.AutoFps_FullRestore()
  pcall(function()
    local al = getAddressList()
    local r1 = al.getMemoryRecordByID(1)
    local manual = (r1 ~= nil) and r1.Active
    if not manual then
      pcall(writeBytes, "ER_FPS_PATCH_ENABLED", 0)
      _G.__ER_FPS_WANTED = false
    end
    if _G.AutoFps_Config and _G.AutoFps_Save then
      _G.AutoFps_Save(_G.AutoFps_Config)
    end
  end)
end

-- 直接关闭 CE 主窗口（不点开关）时，DISABLE 脚本可能不执行，
-- 用 OnClose 兜底，确保退出时游戏恢复原生帧率。
-- 必须返回传入的 CloseAction(ca)，否则默认 caNone 会导致窗口关不掉。
pcall(function()
  local oldOnClose = getMainForm().OnClose
  getMainForm().OnClose = function(sender, ca)
    _G.AutoFps_FullRestore()
    if oldOnClose then
      return oldOnClose(sender, ca)
    else
      return ca
    end
  end
end)

-- ---------- FPS Patch(ID1) 与位置锁帧(ID101) 互斥 ----------
-- OnActivate 在 before=true 时返回 false 可阻止本次激活
pcall(function()
  local al = getAddressList()
  local r1 = al.getMemoryRecordByID(1)
  local r101 = al.getMemoryRecordByID(101)

  r1.OnActivate = function(rec, before, state)
    if before and r101.Active then
      pcall(getMainForm().bringToFront)
      showMessage("Disable Position Trigger first, then enable FPS Patch")
      return false
    end
    return true
  end

  r101.OnActivate = function(rec, before, state)
    if before and r1.Active then
      pcall(getMainForm().bringToFront)
      showMessage("Disable FPS Patch first, then enable Position Trigger")
      return false
    end
    return true
  end
end)</LuaScript>
</CheatTable>
