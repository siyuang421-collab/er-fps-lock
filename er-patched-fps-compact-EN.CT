{$lua}
</AssemblerScript>
        </CheatEntry>
        <CheatEntry>
          <ID>163</ID>
          <Description>"✏ Set FPS"</Description>
          <Color>FFAA00</Color>
          <VariableType>Auto Assembler Script</VariableType>
          <AssemblerScript>[ENABLE]
{$lua}
if syntaxcheck then return end
local rec163 = getMemoryRecordByID(163)
local ok, err = pcall(function()
  if not _G.AutoFps_Config then return end
  pcall(getMainForm().bringToFront)
  local openSlots = {}
  for i = 0, 79 do
    local off = i*24
    local mID = readInteger(_G.AutoFps_Config + off)
    if mID and mID ~= 0 and readInteger(_G.AutoFps_Config + off + 16) == 1 then
      openSlots[#openSlots + 1] = i
    end
  end
  if #openSlots == 0 then showMessage("No open points yet; add one first") return end
  local slot
  if #openSlots == 1 then
    slot = openSlots[1]
  else
    local line = inputQuery("Set FPS", "Enter open-point row number (1-" .. #openSlots .. "):", "1")
    if line == nil then return end
    local num = tonumber(line)
    if not num or num &lt; 1 or num &gt; #openSlots then return end
    slot = openSlots[num]
  end
  local curFps = readFloat(_G.AutoFps_Config + slot*24 + 20)
  local newFps = inputQuery("Set FPS", "Enter new FPS (20-60):", string.format("%.0f", curFps))
  if newFps == nil then return end
  local fps = tonumber(newFps)
  if not fps or fps &lt; 20 or fps &gt; 60 then showMessage("FPS must be between 20 and 60") return end
  writeFloat(_G.AutoFps_Config + slot*24 + 20, fps)
  local okb, b = pcall(readBytes, "ER_FPS_PATCH_ENABLED", 1, false)
  if okb and b == 1 then
    pcall(writeFloat, "ER_FPS_CUSTOM_LIMIT", fps)
  end
  if _G.AutoFps_Save then _G.AutoFps_Save(_G.AutoFps_Config) end
end)
if not ok then
  pcall(getMainForm().bringToFront)
  pcall(showMessage, "Set FPS error: " .. tostring(err))
end
rec163.Active=false
