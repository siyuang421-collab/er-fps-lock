          <AssemblerScript>[ENABLE]
{$lua}
if syntaxcheck then return end
if not _G.AutoFps_Config then getMemoryRecordByID(161).Active=false return end
local wcm = (_G.AutoFps_PtrVarAddr and readQword(_G.AutoFps_PtrVarAddr)) or 0
if not wcm or wcm == 0 then getMemoryRecordByID(161).Active=false return end
local p1 = readQword(wcm + 0x10EF8)
local co = readQword(p1 + 0)
local mID = readInteger(co+0x6D0)
local pX = readFloat(co+0x6C0)
local pY = readFloat(co+0x6C4)
local pZ = readFloat(co+0x6C8)
local curFps = 45
pcall(function()
  local v = getAddressList().getMemoryRecordByID(2).Value
  if v and v &gt;= 20 and v &lt;= 60 then curFps = v end
end)
local slot = -1
for i = 0, 79 do
  if readInteger(_G.AutoFps_Config + i*24) == 0 then slot = i break end
end
if slot &lt; 0 then getMemoryRecordByID(161).Active=false return end
local off = slot * 24
writeInteger(_G.AutoFps_Config+off, mID)
writeFloat(_G.AutoFps_Config+off+4, pX)
writeFloat(_G.AutoFps_Config+off+8, pY)
writeFloat(_G.AutoFps_Config+off+12, pZ)
writeInteger(_G.AutoFps_Config+off+16, 1)
writeFloat(_G.AutoFps_Config+off+20, curFps)
if _G.AutoFps_Save then _G.AutoFps_Save(_G.AutoFps_Config) end
getMemoryRecordByID(161).Active=false
